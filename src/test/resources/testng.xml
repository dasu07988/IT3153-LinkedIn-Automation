<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Sequential on purpose: parallel logins to one LinkedIn account trigger security checks. -->
<suite name="LinkedInAutomation Suite" verbose="1">
    <test name="LinkedIn UI Tests">
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.SearchTest"/>
            <class name="tests.SearchResultTest"/>
        </classes>
    </test>
</suite>
